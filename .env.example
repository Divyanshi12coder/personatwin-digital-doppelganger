# Copy to .env (never commit .env). Used by docker-compose, and by the backend
# when run directly from ./backend (copy it to backend/.env in that case).

# --- App ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------
POSTGRES_USER=personatwin
POSTGRES_PASSWORD=personatwin
POSTGRES_DB=personatwin
# Used when running the backend outside Docker. SQLite also works for quick local runs:
#   DATABASE_URL=sqlite:///./personatwin.db
DATABASE_URL=postgresql+psycopg://personatwin:personatwin@localhost:5432/personatwin

# --- Auth --------------------------------------------------------------
# Production requires >= 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS (comma-separated frontend origins) ---------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- AI provider -------------------------------------------------------
# demo      -> no key needed; answers are composed from retrieved memories
# anthropic -> Claude via the official SDK (default model: claude-opus-5)
# openai    -> OpenAI Chat Completions or any compatible gateway (set AI_BASE_URL)
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Anthropic adaptive-thinking effort: low | medium | high
AI_EFFORT=medium
AI_MAX_TOKENS=2000
# Anthropic server-side refusal fallbacks (Opus 5 / Fable models)
AI_ENABLE_FALLBACKS=true

# --- Embeddings --------------------------------------------------------
# local  -> offline hashed n-gram embeddings (no key)
# openai -> OpenAI embeddings reduced to 384 dims (re-index after switching)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Rate limits (requests per minute) ---------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=30
# Proxies allowed to set X-Forwarded-For (used by the container entrypoint)
# FORWARDED_ALLOW_IPS=127.0.0.1
